---
// Replace the file at this path to update the photograph.
const image = '/images/academics/academics-curriculum-students.webp';

const points = [
  'Nursery, Primary and High School',
  'State Board Curriculum',
  'Regular Assessments',
  'Support for Overall Development',
];
---

<section
  class="relative flex flex-col bg-navy md:block md:min-h-[26rem]"
  aria-labelledby="academics-heading"
>
  <!-- Content panel: slanted right edge on md and up -->
  <div
    class="px-4 py-10 sm:px-6 md:relative md:z-10 md:flex md:min-h-[26rem] md:w-[56%] md:flex-col md:justify-center md:bg-navy md:py-12 md:pr-20 md:pl-[max(1.5rem,calc((100vw_-_80rem)/2_+_1.5rem))] md:[clip-path:polygon(0_0,100%_0,90%_100%,0_100%)]"
  >
    <h2
      id="academics-heading"
      class="text-3xl font-bold tracking-tight text-white"
    >
      Academics & Curriculum
    </h2>
    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
      <div class="h-1 w-12 shrink-0 rounded-full bg-gold"></div>
      <p class="text-sm text-white/90 sm:text-base">
        Building strong foundations for tomorrow.
      </p>
    </div>

    <p class="mt-5 max-w-md text-base leading-relaxed text-white/90">
      We follow the Karnataka State Board curriculum, offering a strong academic
      foundation from Nursery to High School.
    </p>

    <ul class="mt-5 space-y-3">
      {
        points.map((point) => (
          <li class="flex items-center gap-3 text-white">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-gold text-navy">
              <svg
                class="size-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m5 12.500 4.500 4.500L19 7.500" />
              </svg>
            </span>
            {point}
          </li>
        ))
      }
    </ul>

    <a
      href="/academics/curriculum"
      class="mt-7 inline-flex w-fit items-center gap-2 rounded-md bg-gold px-5 py-3 text-sm font-bold text-navy hover:brightness-95"
    >
      Know More
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </div>

  <img
    src={image}
    alt="Students studying together in a classroom"
    width="600"
    height="402"
    loading="lazy"
    class="h-56 w-full object-cover sm:h-72 md:absolute md:inset-y-0 md:right-0 md:h-full md:w-[58%]"
  />
</section>
