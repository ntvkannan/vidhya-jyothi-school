---
// PLACEHOLDER: the student-group photograph is not yet available.
// Set this to the image path once the asset exists; the placeholder box is then replaced.
const groupImage: string | null = null;
---

<section class="bg-maroon text-white" aria-labelledby="admissions-cta-heading">
  <div
    class="mx-auto grid max-w-7xl items-center gap-6 px-4 py-8 sm:px-6 md:grid-cols-[16rem_1fr] md:gap-10 lg:grid-cols-[22rem_1fr] lg:py-10"
  >
    {
      groupImage ? (
        <img
          src={groupImage}
          alt="Students of Vidhya Jyothi School"
          loading="lazy"
          class="h-40 w-full rounded-lg object-cover md:h-48"
        />
      ) : (
        <div
          class="flex h-40 w-full items-center justify-center rounded-lg border border-dashed border-white/40 bg-white/5 text-center text-xs text-white/60 md:h-48"
          role="img"
          aria-label="Student group photo placeholder"
        >
          Student group photo
          <br />
          (to be added)
        </div>
      )
    }

    <div>
      <h2
        id="admissions-cta-heading"
        class="text-3xl font-extrabold tracking-tight sm:text-4xl"
      >
        Admissions Open for 2026–27
      </h2>
      <p class="mt-3 text-base text-white/90 sm:text-lg">
        Nursery to High School
        <span class="mx-2 text-white/50" aria-hidden="true">|</span>
        <span class="block sm:inline">BTM Layout & Hongasandra Campuses</span>
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a
          href="/admissions/admission-enquiry"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-gold px-6 py-3 text-sm font-bold text-navy hover:brightness-95"
        >
          Apply for Admission
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a
          href="/contact/btm-campus"
          class="inline-flex items-center justify-center rounded-md border-2 border-white px-6 py-3 text-sm font-bold text-white hover:bg-white/10"
        >
          Contact Us
        </a>
      </div>
    </div>
  </div>
</section>
