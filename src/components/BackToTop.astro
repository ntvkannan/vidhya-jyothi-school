<button
  type="button"
  id="back-to-top"
  data-visible="false"
  aria-label="Back to top"
  class="invisible fixed right-4 bottom-4 z-40 flex size-11 items-center justify-center rounded-full bg-navy text-white opacity-0 shadow-md transition-[opacity,visibility] duration-200 hover:bg-maroon focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold data-[visible=true]:visible data-[visible=true]:opacity-100 sm:right-6 sm:bottom-6"
>
  <svg
    class="size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="m6 15 6-6 6 6"></path>
  </svg>
</button>

<script>
  const button = document.getElementById('back-to-top');
  const threshold = 400;

  if (button) {
    const update = () => {
      button.dataset.visible = String(window.scrollY > threshold);
    };

    window.addEventListener('scroll', update, { passive: true });
    update();

    button.addEventListener('click', () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
  }
</script>
