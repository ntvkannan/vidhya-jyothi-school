---
type Feature = {
  title: string;
  description: string;
  // Tailwind classes for the circular icon area: background + icon colour.
  tone: string;
  icon: 'cap' | 'heart' | 'people' | 'star';
};

const features: Feature[] = [
  {
    title: 'Academic Excellence',
    description: 'Strong foundation with State Board curriculum.',
    tone: 'bg-gold text-navy',
    icon: 'cap',
  },
  {
    title: 'Value-Based Education',
    description: 'Instilling discipline, respect and compassion.',
    tone: 'bg-maroon text-white',
    icon: 'heart',
  },
  {
    title: 'Experienced Faculty',
    description: 'Dedicated and caring teachers who inspire.',
    tone: 'bg-orange text-white',
    icon: 'people',
  },
  {
    title: 'Holistic Development',
    description: 'Academics, sports, arts and life skills for a brighter future.',
    tone: 'bg-gold text-white',
    icon: 'star',
  },
];

// Filled icons, 24x24 viewBox, drawn with currentColor.
const icons: Record<Feature['icon'], string> = {
  cap: 'M12 3 1 9l11 6 9-4.9V17h2V9L12 3Zm-6 9.2V16c0 1.700 2.700 3 6 3s6-1.300 6-3v-3.800l-6 3.300-6-3.300Z',
  heart:
    'M12 21s-8-5.200-8-11a4.500 4.500 0 0 1 8-2.800A4.500 4.500 0 0 1 20 10c0 5.800-8 11-8 11Z',
  people:
    'M12 11a3.500 3.500 0 1 0 0-7 3.500 3.500 0 0 0 0 7Zm-6 .5a2.500 2.500 0 1 0 0-5 2.500 2.500 0 0 0 0 5Zm12 0a2.500 2.500 0 1 0 0-5 2.500 2.500 0 0 0 0 5ZM12 13c-3 0-6 1.500-6 4v2h12v-2c0-2.500-3-4-6-4ZM5 13.500C3 14 1 15.200 1 17v2h3.500v-2c0-1.500.2-2.800.5-3.500Zm14 0c.3.700.5 2 .5 3.500v2H23v-2c0-1.800-2-3-4-3.500Z',
  star: 'm12 2 3.100 6.300 6.900 1-5 4.900 1.200 6.800L12 17.700 5.800 21l1.200-6.800-5-4.900 6.900-1L12 2Z',
};
---

<section class="bg-white" aria-labelledby="why-choose-heading">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:py-14">
    <h2
      id="why-choose-heading"
      class="text-2xl font-extrabold tracking-tight text-navy sm:text-3xl"
    >
      Why Choose Vidhya Jyothi School?
    </h2>
    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
      <div class="h-1 w-12 shrink-0 rounded-full bg-gold"></div>
      <p class="text-sm text-navy/75 sm:text-base">
        A supportive environment where every child learns, grows and belongs.
      </p>
    </div>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
      {
        features.map((feature) => (
          <li class="rounded-lg border border-navy/10 bg-white p-6 shadow-sm">
            <span
              class:list={[
                'flex size-12 items-center justify-center rounded-full',
                feature.tone,
              ]}
            >
              <svg
                class="size-6"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={icons[feature.icon]} />
              </svg>
            </span>
            <h3 class="mt-4 text-lg font-bold text-navy">{feature.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-navy/70">
              {feature.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
