---
import { withBase } from '../utils/url';
const news = [
  {
    day: '15',
    monthYear: 'Oct 2025',
    title: 'Annual Sports Day',
    description: 'A day of energy, enthusiasm and team spirit.',
    image: '/images/news-events/annual-sports-day.webp',
    alt: 'Students at the annual sports day',
  },
  {
    day: '05',
    monthYear: 'Oct 2025',
    title: 'Dasara Celebration',
    description:
      'Students showcased their talent through music, dance and cultural performances.',
    image: '/images/news-events/dasara-celebration.webp',
    alt: 'Students performing at the Dasara celebration',
  },
  {
    day: '21',
    monthYear: 'Sep 2025',
    title: 'Science Exhibition',
    description: 'Innovative ideas and creative projects by our students.',
    image: '/images/news-events/science-exhibition.webp',
    alt: 'Students presenting projects at the science exhibition',
  },
];

// Add further approved testimonials here; the slider and dots follow this array.
const testimonials = [
  {
    quote:
      'Vidhya Jyothi School has provided a nurturing environment for my child. The teachers are caring and the focus on values is truly commendable.',
    name: 'Parent of Grade 5 Student',
    campus: 'BTM Layout Campus',
    image: '/images/testimonial/parent.webp',
  },
  // TEMPORARY DEMO testimonials for slider testing — NOT approved content. Remove before launch.
  {
    quote:
      'Vidhya Jyothi School has created a positive learning environment where my child feels encouraged to learn and participate.',
    name: 'Parent of Grade 4 Student',
    campus: 'Hongasandra Campus',
    image: '/images/testimonial/parent.webp',
  },
  {
    quote:
      'We are happy with the balance of academics, activities and values. The school encourages children to become confident and responsible.',
    name: 'Parent of Grade 6 Student',
    campus: 'BTM Layout Campus',
    image: '/images/testimonial/parent.webp',
  },
];

const starPath =
  'm12 2 3.100 6.300 6.900 1-5 4.900 1.200 6.800L12 17.700 5.800 21l1.200-6.800-5-4.900 6.900-1L12 2Z';
const arrowBase =
  'flex size-10 items-center justify-center rounded-full border border-navy/15 text-navy hover:bg-navy/5 disabled:cursor-not-allowed disabled:opacity-35 disabled:hover:bg-transparent';
---

<section class="bg-white" aria-labelledby="news-heading">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-4 pb-10 sm:px-6 lg:pb-14 xl:grid-cols-[1.7fr_1fr] xl:items-start xl:gap-10"
  >
    <!-- Latest News & Events -->
    <div class="min-w-0">
      <div data-reveal class="flex items-center justify-between gap-4">
        <h2
          id="news-heading"
          class="text-2xl font-bold tracking-tight whitespace-nowrap text-navy sm:text-3xl"
        >
          Latest News & Events
        </h2>
        <a
          href={withBase('/news-events/news')}
          class="flex items-center gap-1 text-sm font-semibold whitespace-nowrap text-maroon hover:underline"
        >
          View All
          <svg
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>

      <ul data-reveal-stagger class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          news.map((item) => (
            <li class="overflow-hidden rounded-lg border border-navy/10 bg-white shadow-sm">
              <img
                src={withBase(item.image)}
                alt={item.alt}
                loading="lazy"
                class="aspect-[16/10] w-full object-cover"
              />
              <div class="flex gap-3 p-3">
                <div class="w-14 shrink-0 text-center leading-none">
                  <p class="text-2xl font-bold text-maroon">{item.day}</p>
                  <p class="mt-1 text-[11px] text-navy/60">{item.monthYear}</p>
                </div>
                <div class="min-w-0">
                  <h3 class="text-sm leading-snug font-bold text-navy">
                    {item.title}
                  </h3>
                  <p class="mt-1 text-xs leading-relaxed text-navy/70">
                    {item.description}
                  </p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Testimonials slider -->
    <div
      class="min-w-0"
      data-slider
      role="region"
      aria-roledescription="carousel"
      aria-labelledby="testimonials-heading"
    >
      <div data-reveal class="flex items-center justify-between gap-4">
        <h2
          id="testimonials-heading"
          class="text-2xl font-bold tracking-tight text-navy sm:text-3xl xl:text-2xl"
        >
          What Parents & Students Say
        </h2>
        <div class="flex shrink-0 gap-2">
          <button type="button" data-prev class={arrowBase} aria-label="Previous testimonial">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg>
          </button>
          <button type="button" data-next class={arrowBase} aria-label="Next testimonial">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
          </button>
        </div>
      </div>

      <div data-reveal class="-m-1 mt-5 overflow-hidden p-1">
        <div
          data-track
          aria-live="polite"
          class="flex transition-transform duration-300 ease-out motion-reduce:transition-none"
        >
          {testimonials.map((testimonial, i) => (
      <figure
        data-slide
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${testimonials.length}`}
        class="w-full shrink-0 rounded-lg border border-navy/10 bg-white p-6 shadow-sm"
      >
        <svg
          class="size-8 text-gold"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M10 4H4a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h3.200c-.1 2.100-1.200 3.400-3.200 4l.6 2.200C8.100 18.300 10.500 15.500 10.500 11V5a1 1 0 0 0-.5-1Zm10 0h-6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h3.200c-.1 2.100-1.200 3.400-3.200 4l.6 2.200c3.500-.9 5.900-3.700 5.900-8.200V5a1 1 0 0 0-.5-1Z"></path>
        </svg>
        <blockquote class="mt-3 text-base leading-relaxed text-navy/80">
          {testimonial.quote}
        </blockquote>
        <figcaption class="mt-5 flex items-center gap-3">
          <img
            src={withBase(testimonial.image)}
            alt=""
            width="48"
            height="48"
            loading="lazy"
            class="size-12 shrink-0 rounded-full object-cover"
          />
          <div class="min-w-0 flex-1">
            <p class="text-sm font-bold text-navy">{testimonial.name}</p>
            <p class="text-xs text-navy/60">{testimonial.campus}</p>
          </div>
          <div class="flex shrink-0 gap-0.5 text-gold" role="img" aria-label="5 out of 5 stars">
            {
              [0, 1, 2, 3, 4].map(() => (
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={starPath} />
                </svg>
              ))
            }
          </div>
        </figcaption>
      </figure>
          ))}
        </div>
      </div>

      <div class="mt-2 flex justify-center">
        {
          testimonials.map((_, i) => (
            <button
              type="button"
              data-dot
              class="group flex size-6 items-center justify-center"
              aria-label={`Show testimonial ${i + 1}`}
            >
              <span class="size-2 rounded-full bg-navy/20 group-aria-[current=true]:bg-maroon" />
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-slider]');

  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    let index = 0;

    function show(i: number) {
      index = Math.max(0, Math.min(slides.length - 1, i));
      track.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((slide, n) => {
        slide.toggleAttribute('inert', n !== index);
        slide.setAttribute('aria-hidden', String(n !== index));
      });
      dots.forEach((dot, n) => {
        dot.setAttribute('aria-current', String(n === index));
      });
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
    }

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, n) => dot.addEventListener('click', () => show(n)));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    show(0);
  }
</script>
