---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="bg-cream" aria-labelledby="page-title">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:py-28">
    <h1
      id="page-title"
      class="text-3xl font-extrabold tracking-tight text-navy sm:text-4xl"
    >
      {title}
    </h1>
    <div class="mt-4 h-1 w-16 rounded-full bg-gold"></div>
    <p class="mt-6 text-lg font-bold text-maroon">Under Construction</p>
    <p class="mt-2 max-w-xl text-base leading-relaxed text-navy/75">
      This page is currently being prepared. Please check back soon.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center rounded-md border-2 border-navy px-5 py-2.5 text-sm font-bold text-navy hover:bg-navy/5"
    >
      Back to Home
    </a>
  </div>
</section>
